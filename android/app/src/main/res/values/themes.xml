<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Системный splash (Android 12+, на старых — его копия из core-splashscreen): эмблема на #06070B -->
    <style name="Theme.Madridista.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.Madridista</item>
    </style>

    <!-- Основная тема: тёмная, без панели действий; окно тёмное с первого кадра — без белых вспышек -->
    <style name="Theme.Madridista" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/gold</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23" xmlns:tools="http://schemas.android.com/tools">false</item>
    </style>
</resources>
