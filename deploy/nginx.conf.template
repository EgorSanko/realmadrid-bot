    # аватары пользователей: файлы кладёт сборщик (скачивает с t.me через туннель) в {{DATAROOT}}/avatars;
    # nginx на хосте читает их напрямую (папка 0755, файлы 0644). PNG лежит как {id}.png — отдаём его
    # с верным типом. Нет файла — силуэт. Ссылка в API несёт ?v=<mtime>, поэтому кэш у клиента длинный.
    location ~ "^/img/avatar/(?<rmv2id>[1-9]\d{0,15})\.jpg$" {
        root {{DATAROOT}};
        disable_symlinks on;
        try_files /avatars/$rmv2id.jpg /avatars/$rmv2id.png @rmv2_avatar_none;
        access_log off;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location /img/ {
        return 404;
    }

    location @rmv2_avatar_none {
        root {{IMGROOT}};
        try_files /silhouette.svg =404;
        add_header Cache-Control "public, max-age=300" always;
        add_header X-Img-Fallback "silhouette" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # заглушки: отдаём 200, кэш у клиента сутки (вдруг у источника появится настоящая картинка)
    location @rmv2_sportsru_follow {
        set $rmv2_loc $upstream_http_location;
        # только картинки самого sports.ru — не открытый прокси по чужому Location
        if ($rmv2_loc !~ "^https://www\.sports\.ru/dynamic_images/[A-Za-z0-9._~/-]{1,400}\.(?:jpe?g|png|webp)$") {
            return 404;
        }
        proxy_pass $rmv2_loc;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host www.sports.ru;
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36";
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Accept "image/avif,image/webp,image/png,image/*;q=0.8";
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header Vary;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Location;
        proxy_ignore_headers Set-Cookie Cache-Control Expires Vary X-Accel-Expires;
        proxy_cache rmv2img;
        proxy_cache_key $rmv2_loc;
        proxy_cache_valid 200 7d;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        add_header Cache-Control "public, max-age=604800" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location @rmv2_blank {
        root {{IMGROOT}};
        try_files /blank.png =404;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Img-Fallback "blank" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location @rmv2_silhouette {
        root {{IMGROOT}};
        try_files /silhouette.svg =404;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Img-Fallback "silhouette" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # хэшированные файлы сборки
    location /assets/ {
        try_files $uri =404;
        access_log off;
        # без always: на 404 (старый чанк после выкладки) заголовок не ставится — браузер не запомнит ошибку на год
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    # SEO и значки (frontend/public → корень dist): отдаём файлом, а не index.html SPA
    location = /robots.txt {
        try_files $uri =404;
        default_type text/plain;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /sitemap.xml {
        try_files $uri =404;
        default_type application/xml;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /manifest.webmanifest {
        try_files $uri =404;
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options nosniff always;
    }
    # значки и картинка превью: имена без хэша — кэш сутки, не год
    location ~ "^/(favicon\.ico|favicon\.svg|favicon-32\.png|apple-touch-icon\.png|icon-192\.png|icon-512\.png|icon-maskable-512\.png|og\.png)$" {
        try_files $uri =404;
        access_log off;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        # страница приложения: CSP и запреты браузерных API. CSP:
        #  script — свои файлы, инлайн-скрипт заставки по хэшу, виджет входа telegram.org; 'unsafe-eval' нужен
        #           только виджету (он исполняет data-onauth через eval); style 'unsafe-inline' — <style> заставки;
        #  img — только свои /img (картинки чужих хостов идут через наш кэш), data:/blob: — QR и превью;
        #  connect/media https: — HLS трансляции с внешнего хоста (hls.js качает плейлист и сегменты, iOS — нативно);
        #  frame — плеер YouTube на /video и кнопка виджета oauth.telegram.org;
        #  frame-ancestors — Telegram Web (web.telegram.org) открывает мини-апп во фрейме.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' {{CSP_SCRIPT_HASHES}} https://telegram.org 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' blob: https:; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://oauth.telegram.org; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()" always;
{{HSTS}}
    }

    # SPA. Адреса приложения → index.html со статусом 200; неизвестный адрес → та же страница, но со статусом 404
    # (её рисует экран «не найдено»): поисковик не считает мусорные адреса копией главной (soft 404).
    # Новый раздел во фронте — добавить его сюда.
    location = / {
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' {{CSP_SCRIPT_HASHES}} https://telegram.org 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' blob: https:; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://oauth.telegram.org; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()" always;
{{HSTS}}
    }
    location ~ "^/(?:matches|team|media|predict|profile|privacy|terms|admin|games(?:/quiz|/penalty)?|match/[^/]+(?:/.*)?|player/[^/]+|news/[^/]+|video/[^/]+)/?$" {
        try_files /index.html =404;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' {{CSP_SCRIPT_HASHES}} https://telegram.org 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' blob: https:; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://oauth.telegram.org; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()" always;
{{HSTS}}
    }
    location / {
        try_files $uri =404;
        error_page 404 /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' {{CSP_SCRIPT_HASHES}} https://telegram.org 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https:; media-src 'self' blob: https:; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://oauth.telegram.org; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), bluetooth=(), serial=(), hid=()" always;
{{HSTS}}
    }
}
