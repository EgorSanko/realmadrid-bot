    location ~ "^/img/news/sportsru/(?<rmv2p>dynamic_images/[A-Za-z0-9._~/-]{1,400}\.(?:jpe?g|png|webp))$" {
        set $rmv2_up https://www.sports.ru/$rmv2p;
        # sports.ru иногда отвечает 301 на другой файл: идём туда сами (@rmv2_sportsru_follow), а не шлём
        # браузер на чужой хост — его режет CSP img-src 'self', и картинки новости нет
        error_page 301 302 307 308 = @rmv2_sportsru_follow;
        error_page 400 403 404 410 500 502 503 504 = @rmv2_blank;
        proxy_pass $rmv2_up;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
