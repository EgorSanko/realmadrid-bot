# Мадридиста (rm-v2). Сгенерировано deploy/deploy.sh из deploy/nginx.conf.template — руками не править.
# Плейсхолдеры в двойных фигурных скобках: DOMAIN, SCHEME, LISTEN, REDIRECT, WEBROOT, API_PORT, IMGROOT, DATAROOT,
# HSTS (строка add_header Strict-Transport-Security — только при https), CSP_SCRIPT_HASHES (sha256 инлайн-скриптов
# dist/index.html — считает deploy.sh после сборки).
# Зона кэша rmv2img объявлена в /etc/nginx/conf.d/rmv2-img-cache.conf (deploy/nginx-img-cache.conf).
{{REDIRECT}}
# www → домен без www (canonical): тот же listen и сертификат (в нём есть www), один 301 на основной адрес
server {
{{LISTEN}}
    server_name www.{{DOMAIN}};
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 {{SCHEME}}://{{DOMAIN}}$request_uri; }
}

server {
{{LISTEN}}
    server_name {{DOMAIN}};

    root {{WEBROOT}};
    index index.html;
    charset utf-8;
    client_max_body_size 2m;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript text/javascript application/json image/svg+xml application/manifest+json;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
{{HSTS}}

    # API (FastAPI в docker на 127.0.0.1:{{API_PORT}}); буферизация выключена под будущий SSE.
    # Cache-Control ставит само API (лайв max-age=5, остальное 30–60 с).
    location /api/ {
        proxy_pass http://127.0.0.1:{{API_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
    }

    # ---------- картинки: только настоящие, через наш кэш (клиент не ходит на чужие хосты) ----------
    # team/player/league/flag — FotMob и flagcdn; yt — превью YouTube; news — картинки новостей.
    # FotMob на несуществующий id отвечает 403 XML → игроку нейтральный силуэт, команде/лиге/флагу прозрачный 1×1.
    resolver 127.0.0.53 valid=300s ipv6=off;
    resolver_timeout 5s;

    location ~ "^/img/team/(?<rmv2id>\d{1,10})\.png$" {
        set $rmv2_up https://images.fotmob.com/image_resources/logo/teamlogo/$rmv2id.png;
        error_page 400 403 404 410 500 502 503 504 = @rmv2_blank;
        proxy_pass $rmv2_up;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36";
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Accept "image/avif,image/webp,image/png,image/svg+xml,image/*;q=0.8";
        proxy_hide_header Set-Cookie;
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_hide_header Vary;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_ignore_headers Set-Cookie Cache-Control Expires Vary X-Accel-Expires;
        proxy_cache rmv2img;
        proxy_cache_key $rmv2_up;
        proxy_cache_valid 200 30d;
        proxy_cache_valid 403 404 1d;
        proxy_cache_lock on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_intercept_errors on;
        add_header Cache-Control "public, max-age=2592000" always;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ "^/img/player/(?<rmv2id>\d{1,10})\.png$" {
