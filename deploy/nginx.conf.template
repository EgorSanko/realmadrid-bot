    # фото в тексте статей (чтение новости внутри приложения): CDN самих источников.
    # Sports.ru photobooth режет размер по query — у нас он фиксированный (ширина колонки чтения),
    # чужой query из адреса клиента не передаётся.
    location ~ "^/img/news/sportsru-photo/(?<rmv2p>preset/[A-Za-z0-9._~/-]{1,400}\.(?:jpe?g|png|webp))$" {
        set $rmv2_up https://photobooth.cdn.sports.ru/$rmv2p?q=85&w=730;
        error_page 400 403 404 410 500 502 503 504 = @rmv2_blank;
        proxy_pass $rmv2_up;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36";
        proxy_set_header Cookie "";
        proxy_set_header Referer "";
        proxy_set_header Accept "image/avif,image/webp,image/png,image/*;q=0.8";
