    # превью YouTube: /img/yt/{videoId}.jpg → i.ytimg.com (id ровно 11 символов [A-Za-z0-9_-])
    location ~ "^/img/yt/(?<rmv2yt>[A-Za-z0-9_-]{11})\.jpg$" {
        set $rmv2_up https://i.ytimg.com/vi/$rmv2yt/hqdefault.jpg;
        error_page 400 403 404 410 500 502 503 504 = @rmv2_blank;
