{
  "name": "realmadrid-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Single-source frontend for RM WebApp + public site (Block 3 audit 2026-05-11)",
  "scripts": {
    "dev:webapp": "vite --mode webapp",
    "dev:site": "vite --mode site",
    "build:webapp": "vite build --mode webapp",
    "build:site": "vite build --mode site",
    "build": "npm run build:webapp && npm run build:site",
    "preview:webapp": "vite preview --mode webapp",
    "preview:site": "vite preview --mode site"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0"
  }
}
